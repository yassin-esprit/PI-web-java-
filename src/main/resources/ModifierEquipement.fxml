<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModifierEquipementController">
    <Label layoutX="50" layoutY="30" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Modifier Équipement" />

    <Label layoutX="50" layoutY="80" text="Nom:" />
    <TextField fx:id="nomField" layoutX="200" layoutY="75" prefWidth="350" />

    <Label layoutX="50" layoutY="120" text="Description:" />
    <TextField fx:id="descriptionField" layoutX="200" layoutY="115" prefWidth="350" />

    <Label layoutX="50" layoutY="160" text="Quantité Totale:" />
    <TextField fx:id="quantiteTotaleField" layoutX="200" layoutY="155" prefWidth="350" />

    <Label layoutX="50" layoutY="200" text="Quantité Disponible:" />
    <TextField fx:id="quantiteDisponibleField" layoutX="200" layoutY="195" prefWidth="350" />

    <Label layoutX="50" layoutY="240" text="Statut:" />
    <ComboBox fx:id="statutChoiceBox" layoutX="200" layoutY="235" prefWidth="350" />

    <Button layoutX="200" layoutY="290" onAction="#modifierEquipement" text="Enregistrer" />
    <Button layoutX="330" layoutY="290" onAction="#annulerModification" text="Annuler" />
</AnchorPane>