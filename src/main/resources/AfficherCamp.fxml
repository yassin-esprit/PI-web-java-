<AnchorPane prefHeight="458.0" prefWidth="652.0" style="-fx-background-color: linear-gradient(to bottom, #1E3A5F, #2B4D70); -fx-padding: 20;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherCampController">
    <TableView fx:id="tableCampagnes" layoutX="59.0" layoutY="69.0" prefHeight="319.0" prefWidth="558.0" style="-fx-background-color: #FFFFFF; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 5);">
        <columns>
            <TableColumn fx:id="colNomCamp" prefWidth="123.2" text="Nom" style="-fx-background-color: #ffffff; -fx-text-fill: #0a3188; -fx-alignment: CENTER;" />
            <TableColumn fx:id="colBudgetCamp" prefWidth="99.2" text="Budget" style="-fx-background-color: #ffffff; -fx-text-fill: #0a3188; -fx-alignment: CENTER;" />
            <TableColumn fx:id="colDateDebut" prefWidth="130.4" text="Date de Début" style="-fx-background-color: #ffffff; -fx-text-fill: #0a3188; -fx-alignment: CENTER;" />
