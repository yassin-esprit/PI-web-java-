<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: linear-gradient(to right, #2c3e50, #36d8f4); -fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StatCampController">
    <children>
        <!-- Titre principal -->
        <Text layoutX="200.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 24px;" text="STATISTIQUES DES CAMPAGNES" textAlignment="CENTER" wrappingWidth="300">
            <font>
                <Font name="Bell MT Bold" size="22.0" />
            </font>
        </Text>

        <!-- BarChart -->
        <BarChart fx:id="statChart" layoutX="50.0" layoutY="80.0" prefHeight="350.0" prefWidth="600.0" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <xAxis>
                <CategoryAxis label="Statut des Campagnes" side="TOP" fx:id="xAxis">
                    <tickLabelFont>
                        <Font name="Bell MT" size="15.0" />
                    </tickLabelFont>
                </CategoryAxis>
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxis" label="Nombre de campagnes" />
            </yAxis>
        </BarChart>
    </children>
</AnchorPane>