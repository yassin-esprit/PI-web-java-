<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@Style/style.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherEquipementController">
    <!-- HBox pour centrer le titre -->
    <HBox alignment="CENTER" layoutX="0.0" layoutY="10.0" prefWidth="600.0">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Liste des Equipement" textFill="#e48355" />
    </HBox>

    <!-- ListView pour afficher la liste des équipements -->
    <ListView fx:id="listViewEquipement" layoutX="25.0" layoutY="40.0" prefHeight="300.0" prefWidth="550.0" />

    <!-- Boutons -->
    <HBox layoutX="25.0" layoutY="350.0" spacing="10">
        <Button onAction="#GoToModifier" text="Modifier" />
        <Button onAction="#Supprimer" prefHeight="34.0" prefWidth="97.0" text="Supprimer" />
        <Button onAction="#goToReservation" text="Reserver" />
    </HBox>
     <TextField fx:id="searchField" layoutX="325.0" layoutY="353.0" promptText="Rechercher par nom..." />
     <Button layoutX="484.0" layoutY="350.0" onAction="#handleSearch" text="Rechercher" />
</AnchorPane>
