<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@Style/style.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherEquipementController">
    <!-- HBox pour centrer le titre -->
    <HBox alignment="CENTER" layoutX="0.0" layoutY="10.0" prefWidth="600.0">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Liste des Equipement" textFill="#e48355" />
    </HBox>

    <!-- ListView pour afficher la liste des équipements -->
    <ListView fx:id="listViewEquipement" layoutX="25.0" layoutY="40.0" prefHeight="300.0" prefWidth="550.0" />

    <!-- HBox pour organiser les boutons et le champ de recherche -->
    <HBox layoutX="25.0" layoutY="350.0" spacing="10" alignment="CENTER_LEFT">
        <!-- Bouton Modifier -->
        <Button onAction="#GoToModifier" text="Modifier" styleClass="button" />

        <!-- Bouton Supprimer -->
        <Button onAction="#Supprimer" text="Supprimer" styleClass="button supprimer" />

        <!-- Bouton Reserver -->
        <Button onAction="#goToReservation" text="Reserver" styleClass="button reserver" />

        <!-- Bouton Trier -->
        <Button onAction="#trierParQuantite" text="Trier" styleClass="button trier" />

        <!-- Champ de recherche -->
        <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="200" />
    </HBox>
</AnchorPane>