<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="weatherContainer" alignment="CENTER" prefHeight="340.0" prefWidth="278.0" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #3498db); -fx-padding: 20px;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WeatherDialogController">
    <Label fx:id="cityLabel" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="City" />
    <Label fx:id="dateLabel" style="-fx-text-fill: white; -fx-font-size: 18px;" text="Date" />
    <HBox alignment="CENTER" spacing="10">
        <ImageView fx:id="weatherIcon" fitHeight="64" fitWidth="64" />
        <Label fx:id="temperatureLabel" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" text="0°C" />
    </HBox>
    <Label fx:id="conditionLabel" style="-fx-text-fill: white; -fx-font-size: 18px;" text="Condition" />
    <Label fx:id="humidityLabel" style="-fx-text-fill: white; -fx-font-size: 16px;" text="Humidity: 0%" />
    <Label fx:id="windLabel" style="-fx-text-fill: white; -fx-font-size: 16px;" text="Wind: 0 km/h" />
</VBox>
