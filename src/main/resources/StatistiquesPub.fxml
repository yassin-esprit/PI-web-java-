<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: linear-gradient(to bottom, #4079c5, #26c8ba); -fx-padding: 20;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StatistiquesPubController">
    <children>
        <!-- Horizontal container for stats and charts -->
        <HBox layoutX="10.0" layoutY="10.0" spacing="10">
            <!-- Left side: Active/Inactive stats -->
            <VBox spacing="10">
                <Label fx:id="labelStatistiques" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Statistiques des Publicités">
                    <font>
                        <Font name="Arial" size="16"/>
                    </font>
                </Label>
            </VBox>

            <!-- Right side: Likes/Dislikes charts -->
            <VBox fx:id="chartContainer" spacing="10" style="-fx-background-color: transparent;">
            </VBox>
        </HBox>
    </children>
</AnchorPane>