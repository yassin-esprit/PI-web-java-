<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to right, #1E3C72, #2A5298);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherConferencierController">

    <children>
        <!-- Header Section -->
        <VBox alignment="CENTER" layoutX="50.0" layoutY="20.0" spacing="20">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Liste des Conférenciers" />
            </children>
        </VBox>

        <!-- Table Section -->
        <TableView fx:id="tableConferenciers" layoutX="50.0" layoutY="80.0" prefHeight="350.0" prefWidth="800.0" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
            <columns>
                <TableColumn fx:id="colIdConferencier" prefWidth="150.0" text="ID Conférencier" />
                <TableColumn fx:id="colIdEvenement" prefWidth="150.0" text="Titre Événement" />
                <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                <TableColumn fx:id="colBiographie" prefWidth="200.0" text="Biographie" />
                <TableColumn fx:id="colContactEmail" prefWidth="150.0" text="Contact Email" />
            </columns>
        </TableView>

        <!-- Button Section -->
        <HBox alignment="CENTER" layoutX="200.0" layoutY="500.0" spacing="20">
            <children>
                <Button onAction="#loadConferenciers" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12px 20px; -fx-border-radius: 8px;" text="Afficher les Conférenciers" />

                <Button onAction="#deleteConferencier" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12px 20px; -fx-border-radius: 8px;" text="Supprimer" />

                <Button onAction="#modifyConferencier" style="-fx-background-color: #FFC107; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12px 20px; -fx-border-radius: 8px;" text="Modifier" />
            </children>
        </HBox>
    </children>
</AnchorPane>
