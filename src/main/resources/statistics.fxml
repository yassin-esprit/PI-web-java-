<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #36d8f4);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StatisticsController">

    <children>
        <VBox layoutX="50.0" layoutY="30.0" spacing="20">
            <!-- Title with modern, elegant font -->
            <Text fill="white" text="Statistiques des Événements">
                <font>
                    <Font name="Segoe UI" size="32" />
                </font>
            </Text>

            <!-- Button with sleek, futuristic styling -->
<!--            <Button onAction="#retour" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 12px 25px; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgb(255,255,255), 8, 0, 0, 4);" text="Retour" />-->
        </VBox>

        <!-- PieChart for Event Types -->
        <PieChart fx:id="pieChart" title="Répartition des Types d'Événements" legendVisible="true"
                  layoutX="50.0" layoutY="120.0" prefWidth="400.0" prefHeight="400.0"
                  style="-fx-font-size: 18px; -fx-text-fill: white; -fx-background-color: transparent;"/>

        <!-- BarChart for Event Participations -->
        <BarChart fx:id="participationChart" title="Événements avec le Plus de Participations" legendVisible="true"
                  layoutX="500.0" layoutY="120.0" prefWidth="400.0" prefHeight="400.0"
                  style="-fx-font-size: 18px; -fx-text-fill: white; -fx-background-color: transparent;">
            <xAxis>
                <CategoryAxis label="Événements" />
            </xAxis>
            <yAxis>
                <NumberAxis label="Nombre de Participations" />
            </yAxis>
        </BarChart>
    </children>

</AnchorPane>