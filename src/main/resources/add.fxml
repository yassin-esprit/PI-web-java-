<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.collections.FXCollections?>

<?import java.lang.String?>
<AnchorPane prefHeight="731.0" prefWidth="1266.0" style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #36d8f4);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AddUser">
    <children>
        <!-- Title with modern, elegant font -->
        <Text fill="white" layoutX="151.0" layoutY="81.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Create new account">
            <font>
                <Font name="Segoe UI" size="24.0" />
            </font>
        </Text>

        <!-- First Name -->
        <TextField fx:id="fname" alignment="CENTER" layoutX="129.0" layoutY="178.0" prefHeight="35.0" prefWidth="258.0" promptText="First Name" style="-fx-background-color: #ffffff; -fx-border-radius: 8px; -fx-padding: 8px; -fx-font-size: 14px;"/>

        <!-- Last Name -->
        <TextField fx:id="lname" alignment="CENTER" layoutX="129.0" layoutY="230.0" prefHeight="38.0" prefWidth="258.0" promptText="Last Name" style="-fx-background-color: #ffffff; -fx-border-radius: 8px; -fx-padding: 8px; -fx-font-size: 14px;"/>

        <!-- Email -->
        <TextField fx:id="mail" alignment="CENTER" layoutX="129.0" layoutY="281.0" prefHeight="38.0" prefWidth="258.0" promptText="Email" style="-fx-background-color: #ffffff; -fx-border-radius: 8px; -fx-padding: 8px; -fx-font-size: 14px;"/>

        <!-- Phone -->
        <TextField fx:id="phn" alignment="CENTER" layoutX="128.0" layoutY="330.0" prefHeight="38.0" prefWidth="258.0" promptText="Phone Number" style="-fx-background-color: #ffffff; -fx-border-radius: 8px; -fx-padding: 8px; -fx-font-size: 14px;"/>

        <!-- Password -->
        <PasswordField fx:id="pass" alignment="CENTER" layoutX="128.0" layoutY="383.0" prefHeight="38.0" prefWidth="258.0" promptText="Password" style="-fx-background-color: #ffffff; -fx-border-radius: 8px; -fx-padding: 8px; -fx-font-size: 14px;"/>

        <!-- Role Selection -->
        <ComboBox fx:id="roleComboBox" layoutX="129.0" layoutY="440.0" prefHeight="38.0" prefWidth="258.0" style="-fx-background-color: #ffffff; -fx-border-radius: 8px; -fx-font-size: 14px;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="ADMIN"/>
                    <String fx:value="OWNER"/>
                    <String fx:value="PARTICIPANT"/>
                </FXCollections>
            </items>
        </ComboBox>

        <!-- Sign Up Button -->
        <Button fx:id="singupbt" alignment="CENTER" layoutX="134.0" layoutY="517.0" mnemonicParsing="false" onAction="#singup" prefHeight="35.0" prefWidth="236.0" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 12px 25px; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgb(255,255,255), 8, 0, 0, 4);" text="SIGN UP">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <!-- Already have an account? -->
        <Text fill="white" layoutX="144.0" layoutY="649.0" text="Already have an account?" />
        <Hyperlink fx:id="loginurl" layoutX="359.0" layoutY="632.0" onAction="#loginlink" text="Log In" style="-fx-text-fill: white; -fx-font-size: 14px;"/>

        <Label fx:id="welcomeText" layoutX="229.0" layoutY="467.0" />
    </children>
</AnchorPane>
