<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherEvenementController">
    <children>
        <!-- Add a new button to load events -->
        <Button layoutX="274.0" layoutY="35.0" mnemonicParsing="false" onAction="#loadEvenements" text="Afficher les Événements" />

        <TableView fx:id="tableEvenements" layoutX="1.0" layoutY="100.0" prefHeight="200.0" prefWidth="594.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colTitre" prefWidth="75.0" text="Titre" />
                <TableColumn fx:id="colType" prefWidth="75.0" text="Type" />
                <TableColumn fx:id="colDescription" prefWidth="75.0" text="Description" />
                <TableColumn fx:id="colDate" prefWidth="75.0" text="Date" />
                <TableColumn fx:id="colLieu" prefWidth="75.0" text="Lieu" />
                <TableColumn fx:id="colNbrPlaces" prefWidth="75.0" text="Nbr Places" />
                <TableColumn fx:id="colSponsor" prefWidth="75.0" text="Sponsor" />
            </columns>
        </TableView>
        <Button layoutX="274.0" layoutY="35.0" mnemonicParsing="false" onAction="#retour" text="retour" />
    </children>
</AnchorPane>
