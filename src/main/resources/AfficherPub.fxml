<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="509.0" prefWidth="777.0" style="-fx-background-color: linear-gradient(to right, #2c3e50, #36d8f4); -fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherPubController">
    <children>
        <Text layoutX="212.0" layoutY="42.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: white;" text="La liste des Publicites" textAlignment="CENTER" wrappingWidth="324.7998962402344">
            <font>
                <Font name="FiraCode Nerd Font Bold" size="24.0" />
            </font>
        </Text>

        <!-- Champ de recherche -->
        <TextField fx:id="searchField" layoutX="41.0" layoutY="70.0" prefWidth="200.0" promptText="Rechercher..." style="-fx-background-color: white; -fx-padding: 5px; -fx-border-radius: 5px;" />

        <!-- ComboBox pour le tri -->
        <ComboBox fx:id="statusFilter" layoutX="270.0" layoutY="70.0" prefWidth="150.0" style="-fx-background-color: white; -fx-border-radius: 5px;" />

        <!-- ListView remplaçant le TableView -->
        <ListView fx:id="listView" layoutX="41.0" layoutY="125.0" prefHeight="267.0" prefWidth="696.0" style="-fx-background-color: rgba(255, 255, 255, 0.8); -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-selection-bar: #1abc9c; -fx-selection-bar-non-focused: #1abc9c; -fx-selection-bar-text: white;" />

        <!-- Bouton Supprimer -->
        <Button fx:id="idSupprimer" layoutX="50.0" layoutY="462.0" mnemonicParsing="false" onAction="#supprimer" prefHeight="26.0" prefWidth="113.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" text="Supprimer" />

        <!-- Bouton Modifier -->
        <Button fx:id="idModifier" layoutX="50.0" layoutY="408.0" mnemonicParsing="false" onAction="#modifier" prefHeight="26.0" prefWidth="113.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" text="Modifier" />

        <Button fx:id="idOpenMap" layoutX="623.0" layoutY="433.0" mnemonicParsing="false" onAction="#openMap" prefHeight="26.0" prefWidth="113.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" text="Open Map" />
        <!-- Logo -->
        <ImageView fitHeight="120.0" fitWidth="180.0" layoutX="500.0" layoutY="0.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@Images/logo.png" />
            </image>
        </ImageView>

        <!-- Autres boutons -->
        <Button fx:id="idReserver" layoutX="250.0" layoutY="432.0" mnemonicParsing="false" onAction="#gotoCampagnePub" prefHeight="30.0" prefWidth="165.0" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" text="Ajouter Campagne" />
        <Button fx:id="idStatistiques" layoutX="439.0" layoutY="432.0" mnemonicParsing="false" onAction="#afficherStatistiques" prefHeight="26.0" prefWidth="150.0" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" text="Statistiques" />
    </children>
</AnchorPane>
