<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to right, #1E3C72, #2A5298);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterEvenementController">

   <children>
      <!-- Header Section -->
      <VBox alignment="CENTER" layoutX="50.0" layoutY="20.0" spacing="20">
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Ajouter un Événement" />
         </children>
      </VBox>

      <!-- Form Section -->
      <VBox alignment="CENTER" layoutX="50.0" layoutY="80.0" prefWidth="800.0" spacing="15">
         <children>
            <TextField fx:id="txtTitre" promptText="Titre de l'événement" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

            <TextField fx:id="txtType" promptText="Type d'événement" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

            <TextField fx:id="txtDescription" promptText="Description" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

            <DatePicker fx:id="txtDate" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="50.0" promptText="Date de l'événement" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

            <TextField fx:id="txtLieu" promptText="Lieu" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

            <TextField fx:id="txtNbrPlaces" promptText="Nombre de places disponibles" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

            <TextField fx:id="txtSponsor" promptText="Nom du sponsor" style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

            <!-- Button Section -->
            <HBox alignment="CENTER" spacing="20">
               <Button onAction="#ajouterEV" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12px 30px; -fx-border-radius: 8px;" text="Ajouter" />


            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
