<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Pos?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterEvenementController" style="-fx-background-color: #f4f4f4;">
   <children>
      <!-- Header Section -->
      <VBox layoutX="0.0" layoutY="0.0" prefWidth="600.0" alignment="CENTER" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
         <children>
            <Label text="Ajouter Événement" textFill="white" />
         </children>
      </VBox>

      <!-- Form Section -->
      <VBox layoutX="50.0" layoutY="60.0" spacing="10" alignment="CENTER" prefWidth="500.0">
         <children>
            <TextField fx:id="txtTitre" promptText="Titre" style="-fx-border-radius: 5; -fx-background-radius: 5;" />
            <TextField fx:id="txtType" promptText="Type" style="-fx-border-radius: 5; -fx-background-radius: 5;" />
            <TextField fx:id="txtDescription" promptText="Description" style="-fx-border-radius: 5; -fx-background-radius: 5;" />
            <DatePicker fx:id="txtDate" promptText="Date" style="-fx-border-radius: 5; -fx-background-radius: 5;" />
            <TextField fx:id="txtLieu" promptText="Lieu" style="-fx-border-radius: 5; -fx-background-radius: 5;" />
            <TextField fx:id="txtNbrPlaces" promptText="Nombre de Places" style="-fx-border-radius: 5; -fx-background-radius: 5;" />
            <TextField fx:id="txtSponsor" promptText="Sponsor" style="-fx-border-radius: 5; -fx-background-radius: 5;" />

            <!-- Button Section -->
            <HBox alignment="CENTER">
               <Button text="Ajouter" onAction="#ajouterEV" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" />
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
