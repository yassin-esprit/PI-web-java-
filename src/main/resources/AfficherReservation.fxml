<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherReservationController">

    <!-- HBox pour centrer le titre -->
    <HBox alignment="CENTER" spacing="10">
        <Label text="Liste des réservations" style="-fx-font-size: 18px; -fx-font-weight: bold;" textFill="#e48355"/>
    </HBox>

    <!-- TableView pour afficher les réservations -->
    <TableView fx:id="reservationTable">
        <columns>
            <TableColumn fx:id="colIdEquipment" text="ID Equipment" />
            <TableColumn fx:id="colIdEvenement" text="ID Evenement" />
            <TableColumn fx:id="colDateReservation" text="Date Reservation" />
            <TableColumn fx:id="colStatut" text="Statut" />
        </columns>
    </TableView>

    <!-- HBox pour les boutons Modifier et Supprimer -->
    <HBox spacing="10" alignment="center">
        <Button fx:id="btnModifier" text="Modifier" onAction="#handleModifierButton" disable="true"/>
        <Button fx:id="btnSupprimer" text="Supprimer" onAction="#handleSupprimerButton" disable="true"/>
    </HBox>
</VBox>
