<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="600.0" stylesheets="@Style/ResStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherReservationController">
    <!-- HBox pour centrer le titre -->
    <HBox alignment="CENTER" spacing="10">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Liste des réservations" textFill="#e48355" />
    </HBox>

    <!-- TableView pour afficher les réservations -->
    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNomEquipement" prefWidth="146.39999389648438" text="Nom Equipement" />
            <TableColumn fx:id="colTitreEvenement" prefWidth="155.20001220703125" text="Titre Evenement" />
            <TableColumn fx:id="colDateReservation" prefWidth="162.4000244140625" text="Date Reservation" />
            <TableColumn fx:id="colStatut" prefWidth="135.99993896484375" text="Statut" />
        </columns>
    </TableView>

    <!-- HBox pour les boutons Modifier et Supprimer -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnModifier" disable="true" onAction="#handleModifierButton" text="Modifier" />
        <Button fx:id="btnSupprimer" disable="true" onAction="#handleSupprimerButton" text="Supprimer" />
      <Button fx:id="Calender" mnemonicParsing="false" onAction="#Calender" text="Calender" />
    </HBox>
</VBox>
