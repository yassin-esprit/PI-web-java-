<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AjouterEquipementController"
            prefHeight="400.0" prefWidth="600.0">

    <!-- Titre -->
    <Label text="Ajouter un équipement" layoutX="220" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Champ pour le nom -->
    <Label text="Nom de l'équipement" layoutX="20" layoutY="70"/>
    <TextField fx:id="nomTextField" layoutX="160" layoutY="65" prefWidth="200"/>

    <!-- Champ pour la description -->
    <Label text="Description" layoutX="20" layoutY="120"/>
    <TextField fx:id="descriptionTextField" layoutX="160" layoutY="115" prefWidth="200"/>

    <!-- Champ pour la quantité totale -->
    <Label text="Quantité totale" layoutX="20" layoutY="170"/>
    <TextField fx:id="quantiteTotaleTextField" layoutX="160" layoutY="165" prefWidth="200"/>

    <!-- Champ pour la quantité disponible -->
    <Label text="Quantité disponible" layoutX="20" layoutY="220"/>
    <TextField fx:id="quantiteDisponibleTextField" layoutX="160" layoutY="215" prefWidth="200"/>

    <!-- ChoiceBox pour le statut -->
    <Label text="Statut" layoutX="20" layoutY="270"/>
    <ChoiceBox fx:id="statutChoiceBox" layoutX="160" layoutY="265" prefWidth="200"/>

    <!-- Bouton pour ajouter -->
    <Button text="Ajouter" layoutX="220" layoutY="320" onAction="#ajouterEquipement"/>
</AnchorPane>
