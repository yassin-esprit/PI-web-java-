<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to right, #1E3C72, #2A5298);"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierConferencierController">

    <children>
        <!-- Header Section -->
        <VBox alignment="CENTER" layoutX="50.0" layoutY="20.0" spacing="20">
            <children>
                <Label text="Modifier un Conférencier"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
            </children>
        </VBox>

        <!-- Form Section -->
        <VBox alignment="CENTER" layoutX="50.0" layoutY="80.0" prefWidth="800.0" spacing="15">
            <children>
                <TextField fx:id="txtIdEvenement" promptText="ID Événement"
                           style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

                <TextField fx:id="txtNom" promptText="Nom du Conférencier"
                           style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

                <TextField fx:id="txtBiographie" promptText="Biographie"
                           style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

                <TextField fx:id="txtContactEmail" promptText="Email de Contact"
                           style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 100%;" />

                <!-- Button Section -->
                <HBox alignment="CENTER" spacing="20">
                    <Button text="Enregistrer" onAction="#saveChanges"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12px 30px; -fx-border-radius: 8px;" />

                    <Button text="Annuler" onAction="#cancel"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12px 30px; -fx-border-radius: 8px;" />
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
